{
  "runtime": {
    "run_duration_ms": 2200,
    "raw_queue_capacity": 32
  },
  "devices": [
    {
      "id": "machine-01",
      "driver": "simulator_poll",
      "driver_config": {
        "latency_ms": 35
      },
      "connection": {},
      "points": [
        {
          "name": "temperature",
          "type": "double",
          "unit": "C",
          "address": {},
          "scale": 1.0,
          "offset": 0.0,
          "minimum": -40.0,
          "maximum": 120.0
        },
        {
          "name": "pressure",
          "type": "double",
          "unit": "kPa",
          "address": {},
          "scale": 1.0,
          "offset": 0.0
        }
      ]
    },
    {
      "id": "vibration-feed",
      "driver": "simulator_push",
      "driver_config": {
        "interval_ms": 180
      },
      "connection": {},
      "points": [
        {
          "name": "vibration_x",
          "type": "double",
          "unit": "g",
          "address": {},
          "scale": 1.0,
          "offset": 0.0
        },
        {
          "name": "vibration_y",
          "type": "double",
          "unit": "g",
          "address": {},
          "scale": 1.0,
          "offset": 0.0
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "temperature-group",
      "device_id": "machine-01",
      "interval_ms": 300,
      "timeout_ms": 150,
      "points": ["temperature"]
    },
    {
      "id": "pressure-group",
      "device_id": "machine-01",
      "interval_ms": 300,
      "timeout_ms": 150,
      "points": ["pressure"]
    }
  ],
  "processors": [
    {
      "type": "threshold",
      "input": "temperature",
      "greater_than": 85.0,
      "output": "temperature_alarm"
    },
    {
      "type": "window_average",
      "input": "vibration_x",
      "window": 3,
      "output": "vibration_x_avg"
    },
    {
      "type": "inference",
      "runner": "demo_rms",
      "inputs": ["vibration_x", "vibration_y"],
      "outputs": ["anomaly_score"]
    }
  ]
}
